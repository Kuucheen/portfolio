---
interface Props {
	art: string;
	atlasSrc: string;
	label: string;
	id?: string;
	cellSize?: number;
	atlasColumns?: number;
	animated?: boolean;
	fullWidth?: boolean;
	ascentWeights?: Partial<{ left: number; straight: number; right: number }>;
	topWeights?: Partial<{ up: number; straight: number; down: number }>;
	descentWeights?: Partial<{ left: number; straight: number; right: number }>;
}

const {
	art,
	atlasSrc,
	label,
	id,
	cellSize = 16,
	atlasColumns = 16,
	animated = false,
	fullWidth = false,
	ascentWeights = {},
	topWeights = {},
	descentWeights = {},
} = Astro.props;

const resolvedAscentWeights = { left: 1, straight: 1, right: 1, ...ascentWeights };
const resolvedTopWeights = { up: 1, straight: 1, down: 1, ...topWeights };
const resolvedDescentWeights = { left: 1, straight: 1, right: 1, ...descentWeights };

const lines = art.replace(/\r/g, '').split('\n');
if (lines.at(-1) === '') lines.pop();

let minX = Number.POSITIVE_INFINITY;
let minY = Number.POSITIVE_INFINITY;
let maxX = Number.NEGATIVE_INFINITY;
let maxY = Number.NEGATIVE_INFINITY;

for (let y = 0; y < lines.length; y += 1) {
	const characters = Array.from(lines[y]);
	for (let x = 0; x < characters.length; x += 1) {
		if (characters[x] === ' ' || characters[x] === '\u00a0') continue;
		minX = Math.min(minX, x);
		minY = Math.min(minY, y);
		maxX = Math.max(maxX, x);
		maxY = Math.max(maxY, y);
	}
}

const hasVisibleGlyphs = Number.isFinite(minX);
const offsetX = hasVisibleGlyphs ? minX : 0;
const offsetY = hasVisibleGlyphs ? minY : 0;
const columns = hasVisibleGlyphs ? maxX - minX + 1 : 0;
const rows = hasVisibleGlyphs ? maxY - minY + 1 : 0;
---

<figure
	id={id}
	class:list={['ascii-canvas', { 'ascii-canvas--full-width': fullWidth }]}
	data-ascii-canvas
	data-atlas-src={atlasSrc}
	data-cell-size={cellSize}
	data-atlas-columns={atlasColumns}
	data-offset-x={offsetX}
	data-offset-y={offsetY}
	data-animated={animated}
	data-full-width={fullWidth}
	data-ascent-left-weight={resolvedAscentWeights.left}
	data-ascent-straight-weight={resolvedAscentWeights.straight}
	data-ascent-right-weight={resolvedAscentWeights.right}
	data-top-up-weight={resolvedTopWeights.up}
	data-top-straight-weight={resolvedTopWeights.straight}
	data-top-down-weight={resolvedTopWeights.down}
	data-descent-left-weight={resolvedDescentWeights.left}
	data-descent-straight-weight={resolvedDescentWeights.straight}
	data-descent-right-weight={resolvedDescentWeights.right}
>
	<canvas
		width={columns * cellSize}
		height={rows * cellSize}
		role="img"
		aria-label={label}
	></canvas>
	<pre class="fallback" hidden aria-hidden="true">{art}</pre>
	<script type="application/json" class="source" set:html={JSON.stringify(art)}></script>
</figure>

<script>
	interface Glyph {
		code: number;
		character: string;
		x: number;
		y: number;
	}

	interface Point {
		x: number;
		y: number;
	}

	interface LightningGlyph extends Point {
		code: number;
		createdAt: number;
		rotation: number;
		scaleX: number;
		scaleY: number;
	}

	interface StarGlyph extends Point {
		code: number;
		scale: number;
		maxOpacity: number;
		cycleDuration: number;
		cycleOffset: number;
		flickerPeriod: number;
		flickerOffset: number;
	}

	interface WeightedGlyph {
		glyph: Glyph;
		weight: number;
	}

	type Phase = 'up' | 'right' | 'down' | 'bottom' | 'lightning';

	const TICK_MS = 200;
	const FAST_TICK_MS = TICK_MS / 2;
	const TRAIL_DURATION_MS = TICK_MS * 9;
	const LIGHTNING_GLYPHS = ['/','\\','|','-','+','*'];
	const STAR_GLYPHS = ['.', "'", '`', ',', ':'];

	function loadImage(src: string): Promise<HTMLImageElement> {
		return new Promise((resolve, reject) => {
			const image = new Image();
			image.addEventListener('load', () => resolve(image), { once: true });
			image.addEventListener('error', () => reject(new Error(`Could not load ${src}`)), {
				once: true,
			});
			image.src = src;
		});
	}

	function makeMask(atlas: HTMLImageElement): HTMLCanvasElement {
		const mask = document.createElement('canvas');
		mask.width = atlas.naturalWidth;
		mask.height = atlas.naturalHeight;
		const context = mask.getContext('2d', { willReadFrequently: true });
		if (!context) return mask;

		context.drawImage(atlas, 0, 0);
		const pixels = context.getImageData(0, 0, mask.width, mask.height);
		const [keyR, keyG, keyB] = pixels.data;

		for (let index = 0; index < pixels.data.length; index += 4) {
			const r = pixels.data[index];
			const g = pixels.data[index + 1];
			const b = pixels.data[index + 2];
			const originalAlpha = pixels.data[index + 3];
			const isBackground = r === keyR && g === keyG && b === keyB;

			pixels.data[index] = 255;
			pixels.data[index + 1] = 255;
			pixels.data[index + 2] = 255;
			pixels.data[index + 3] = isBackground
				? 0
				: Math.round((Math.max(r, g, b) / 255) * originalAlpha);
		}

		context.clearRect(0, 0, mask.width, mask.height);
		context.putImageData(pixels, 0, 0);
		return mask;
	}

	async function initializeAsciiCanvas(element: HTMLElement): Promise<void> {
		if (element.dataset.initialized === 'true') return;
		element.dataset.initialized = 'true';

		const canvas = element.querySelector('canvas');
		const fallback = element.querySelector<HTMLPreElement>('.fallback');
		const source = element.querySelector<HTMLScriptElement>('.source');
		if (!(canvas instanceof HTMLCanvasElement) || !source) return;

		const context = canvas.getContext('2d');
		if (!context) return;

		const atlasSrc = element.dataset.atlasSrc;
		const cellSize = Number(element.dataset.cellSize ?? 16);
		const atlasColumns = Number(element.dataset.atlasColumns ?? 16);
		const offsetX = Number(element.dataset.offsetX ?? 0);
		const offsetY = Number(element.dataset.offsetY ?? 0);
		const fullWidth = element.dataset.fullWidth === 'true';
		if (!atlasSrc) return;

		const artColumns = Math.floor(canvas.width / cellSize);
		if (fullWidth && element.clientWidth > canvas.width) {
			canvas.width = Math.ceil(element.clientWidth / cellSize) * cellSize;
		}
		const canvasColumns = Math.floor(canvas.width / cellSize);
		const artOffsetX = Math.floor((canvasColumns - artColumns) / 2);

		let art: string;
		try {
			art = JSON.parse(source.textContent ?? '""');
		} catch {
			return;
		}

		let atlas: HTMLImageElement;
		try {
			atlas = await loadImage(atlasSrc);
		} catch (error) {
			canvas.hidden = true;
			if (fallback) fallback.hidden = false;
			console.error(error);
			return;
		}

		const mask = makeMask(atlas);
		const glyphs: Glyph[] = [];
		const glyphGrid = new Map<string, Glyph>();
		const lines = art.replace(/\r/g, '').split('\n');
		for (let y = 0; y < lines.length; y += 1) {
			const characters = Array.from(lines[y]);
			for (let x = 0; x < characters.length; x += 1) {
				const character = characters[x];
				if (character === ' ' || character === '\u00a0') continue;

				const code = character.codePointAt(0);
				if (code !== undefined && code <= 255) {
					const glyph = { code, character, x: x - offsetX + artOffsetX, y: y - offsetY };
					glyphs.push(glyph);
					glyphGrid.set(`${glyph.x},${glyph.y}`, glyph);
				}
			}
		}

		context.imageSmoothingEnabled = false;

		function makeTintedAtlas(color: string): HTMLCanvasElement {
			const tinted = document.createElement('canvas');
			tinted.width = mask.width;
			tinted.height = mask.height;
			const tintedContext = tinted.getContext('2d');
			if (!tintedContext) return tinted;
			tintedContext.imageSmoothingEnabled = false;
			tintedContext.drawImage(mask, 0, 0);
			tintedContext.globalCompositeOperation = 'source-in';
			tintedContext.fillStyle = color;
			tintedContext.fillRect(0, 0, tinted.width, tinted.height);
			return tinted;
		}

		function drawGlyph(
			atlasImage: HTMLCanvasElement,
			code: number,
			x: number,
			y: number,
		): void {
			const sourceX = (code % atlasColumns) * cellSize;
			const sourceY = Math.floor(code / atlasColumns) * cellSize;
			context.drawImage(
				atlasImage,
				sourceX,
				sourceY,
				cellSize,
				cellSize,
				x * cellSize,
				y * cellSize,
				cellSize,
				cellSize,
			);
		}

		const styles = getComputedStyle(element);
		const baseColor = styles.getPropertyValue('--text-white').trim() || '#ffffff';
		const accentColor = styles.getPropertyValue('--accent-blue-dark').trim() || '#2832a5';
		const starRedColor = styles.getPropertyValue('--accent').trim() || '#d4473d';
		const baseAtlas = makeTintedAtlas(baseColor);
		const accentAtlas = makeTintedAtlas(accentColor);
		const starRedAtlas = makeTintedAtlas(starRedColor);
		const shouldAnimate = element.dataset.animated === 'true';
		const columns = canvasColumns;
		const rows = Math.floor(canvas.height / cellSize);

		function makeRandom(seed: number): () => number {
			return () => {
				seed += 0x6D2B79F5;
				let value = seed;
				value = Math.imul(value ^ (value >>> 15), value | 1);
				value ^= value + Math.imul(value ^ (value >>> 7), value | 61);
				return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
			};
		}

		function createStars(): StarGlyph[] {
			const random = makeRandom((columns * 73856093) ^ (rows * 19349663) ^ glyphs.length);
			const candidates: Point[] = [];

			for (let y = 0; y < rows; y += 1) {
				for (let x = 0; x < columns; x += 1) {
					if (glyphGrid.has(`${x},${y}`)) continue;
					const touchesArtwork = [-1, 0, 1].some((offsetY) =>
						[-1, 0, 1].some((offsetX) => glyphGrid.has(`${x + offsetX},${y + offsetY}`)),
					);
					if (!touchesArtwork) candidates.push({ x, y });
				}
			}

			for (let index = candidates.length - 1; index > 0; index -= 1) {
				const swapIndex = Math.floor(random() * (index + 1));
				[candidates[index], candidates[swapIndex]] = [candidates[swapIndex], candidates[index]];
			}

			const targetCount = Math.max(7, Math.round((columns * rows) / 70));
			const chosen: Point[] = [];
			for (const candidate of candidates) {
				const hasRoom = chosen.every(
					(star) => Math.max(Math.abs(star.x - candidate.x), Math.abs(star.y - candidate.y)) >= 3,
				);
				if (!hasRoom) continue;
				chosen.push(candidate);
				if (chosen.length >= targetCount) break;
			}

			return chosen.map((point, index) => ({
				...point,
				code: STAR_GLYPHS[index % STAR_GLYPHS.length].codePointAt(0) ?? 46,
				scale: 0.28 + random() * 0.22,
				maxOpacity: 0.48 + random() * 0.38,
				cycleDuration: 8000 + random() * 9000,
				cycleOffset: random() * 17000,
				flickerPeriod: 180 + random() * 260,
				flickerOffset: random() * 1000,
			}));
		}

		const stars = shouldAnimate ? createStars() : [];

		function drawScaledGlyph(
			atlasImage: HTMLCanvasElement,
			code: number,
			x: number,
			y: number,
			scale: number,
			alpha: number,
		): void {
			const sourceX = (code % atlasColumns) * cellSize;
			const sourceY = Math.floor(code / atlasColumns) * cellSize;
			const size = cellSize * scale;
			context.save();
			context.globalAlpha = alpha;
			context.drawImage(
				atlasImage,
				sourceX,
				sourceY,
				cellSize,
				cellSize,
				(x + 0.5) * cellSize - size / 2,
				(y + 0.5) * cellSize - size / 2,
				size,
				size,
			);
			context.restore();
		}

		function renderStars(now: number, staticFrame = false): void {
			for (const star of stars) {
				if (staticFrame) {
					drawScaledGlyph(baseAtlas, star.code, star.x, star.y, star.scale, star.maxOpacity * 0.5);
					continue;
				}

				const cycleProgress = ((now + star.cycleOffset) % star.cycleDuration) / star.cycleDuration;
				const fade = Math.sin(Math.PI * cycleProgress) ** 2;
				const flickerWave = Math.max(
					0,
					Math.sin(((now + star.flickerOffset) / star.flickerPeriod) * Math.PI * 2),
				);
				const redFlicker = flickerWave ** 14;
				const alpha = fade * star.maxOpacity;

				drawScaledGlyph(
					baseAtlas,
					star.code,
					star.x,
					star.y,
					star.scale,
					alpha * (1 - redFlicker * 0.7),
				);
				drawScaledGlyph(
					starRedAtlas,
					star.code,
					star.x,
					star.y,
					star.scale,
					alpha * redFlicker,
				);
			}
		}

		function renderStatic(includeStars = false): void {
			context.clearRect(0, 0, canvas.width, canvas.height);
			if (includeStars) renderStars(0, true);
			for (const glyph of glyphs) {
				drawGlyph(baseAtlas, glyph.code, glyph.x, glyph.y);
			}
		}

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (!shouldAnimate || reducedMotion || canvas.width === 0 || canvas.height === 0) {
			renderStatic(shouldAnimate);
			return;
		}

		const maxY = rows - 1;
		const glyphsByRow = new Map<number, Glyph[]>();
		const glyphsByColumn = new Map<number, Glyph[]>();
		for (const glyph of glyphs) {
			glyphsByRow.set(glyph.y, [...(glyphsByRow.get(glyph.y) ?? []), glyph]);
			glyphsByColumn.set(glyph.x, [...(glyphsByColumn.get(glyph.x) ?? []), glyph]);
		}
		const bottomGlyphs = glyphsByRow.get(maxY) ?? [];
		const bottomLeft = bottomGlyphs.reduce(
			(leftmost, glyph) => glyph.x < leftmost.x ? glyph : leftmost,
			bottomGlyphs[0],
		);
		const bottomRight = bottomGlyphs.reduce(
			(rightmost, glyph) => glyph.x > rightmost.x ? glyph : rightmost,
			bottomGlyphs[0],
		);
		let bottomLeftIslandMaxX = bottomLeft.x;
		while (glyphGrid.has(`${bottomLeftIslandMaxX + 1},${maxY}`)) bottomLeftIslandMaxX += 1;
		const bottomLeftIslandGlyphs = bottomGlyphs.filter(
			(glyph) => glyph.x >= bottomLeft.x && glyph.x <= bottomLeftIslandMaxX,
		);
		let bottomRightIslandMinX = bottomRight.x;
		while (glyphGrid.has(`${bottomRightIslandMinX - 1},${maxY}`)) bottomRightIslandMinX -= 1;

		function pointKey(point: Point): string {
			return `${point.x},${point.y}`;
		}

		const downReachable = new Set(
			bottomGlyphs
				.filter((glyph) => glyph.x >= bottomRightIslandMinX)
				.map(pointKey),
		);
		for (let y = maxY - 1; y >= 0; y -= 1) {
			for (const glyph of glyphsByRow.get(y) ?? []) {
				if ([-1, 0, 1].some((offset) => downReachable.has(`${glyph.x + offset},${y + 1}`))) {
					downReachable.add(pointKey(glyph));
				}
			}
		}

		const topRightTransitionX = artOffsetX + Math.round((artColumns - 1) * 0.75);
		const rightReachable = new Set(
			(glyphsByColumn.get(topRightTransitionX) ?? [])
				.filter((glyph) => downReachable.has(pointKey(glyph)))
				.map(pointKey),
		);
		for (let x = topRightTransitionX - 1; x >= 0; x -= 1) {
			for (const glyph of glyphsByColumn.get(x) ?? []) {
				if ([-1, 0, 1].some((offset) => rightReachable.has(`${x + 1},${glyph.y + offset}`))) {
					rightReachable.add(pointKey(glyph));
				}
			}
		}

		const upwardFromStart = new Set(bottomLeftIslandGlyphs.map(pointKey));
		for (let y = maxY - 1; y >= 0; y -= 1) {
			for (const glyph of glyphsByRow.get(y) ?? []) {
				if ([-1, 0, 1].some((offset) => upwardFromStart.has(`${glyph.x + offset},${y + 1}`))) {
					upwardFromStart.add(pointKey(glyph));
				}
			}
		}
		const preferredTopTransitionY = Math.round(maxY * 0.12);
		const topTransitionY = glyphs
			.filter((glyph) => upwardFromStart.has(pointKey(glyph)) && rightReachable.has(pointKey(glyph)))
			.map((glyph) => glyph.y)
			.sort((a, b) => Math.abs(a - preferredTopTransitionY) - Math.abs(b - preferredTopTransitionY))[0];
		const upReachable = new Set(
			(glyphsByRow.get(topTransitionY) ?? [])
				.filter((glyph) => rightReachable.has(pointKey(glyph)) && upwardFromStart.has(pointKey(glyph)))
				.map(pointKey),
		);
		for (let y = topTransitionY + 1; y <= maxY; y += 1) {
			for (const glyph of glyphsByRow.get(y) ?? []) {
				if ([-1, 0, 1].some((offset) => upReachable.has(`${glyph.x + offset},${y - 1}`))) {
					upReachable.add(pointKey(glyph));
				}
			}
		}
		const cycleStartGlyphs = bottomLeftIslandGlyphs.filter((glyph) => upReachable.has(pointKey(glyph)));
		const chooseCycleStart = (): Glyph => (
			cycleStartGlyphs[Math.floor(Math.random() * cycleStartGlyphs.length)] ?? bottomLeft
		);
		let cycleStart = chooseCycleStart();
		const trail = new Map<string, number>();
		let lightning: LightningGlyph[] = [];
		let lightningHead: Point = { x: cycleStart.x, y: maxY };
		let position: Point = { x: cycleStart.x, y: cycleStart.y };
		let phase: Phase = 'up';
		let lastStepAt = performance.now();
		let slashWaitUntil = 0;
		let slashLanding: Point | null = null;
		const readWeight = (value: string | undefined): number => {
			const weight = Number(value);
			return Number.isFinite(weight) && weight >= 0 ? weight : 1;
		};
		const ascentMoveWeights: Array<[number, number]> = [
			[-1, readWeight(element.dataset.ascentLeftWeight)],
			[0, readWeight(element.dataset.ascentStraightWeight)],
			[1, readWeight(element.dataset.ascentRightWeight)],
		];
		const topMoveWeights: Array<[number, number]> = [
			[-1, readWeight(element.dataset.topUpWeight)],
			[0, readWeight(element.dataset.topStraightWeight)],
			[1, readWeight(element.dataset.topDownWeight)],
		];
		const descentMoveWeights: Array<[number, number]> = [
			[-1, readWeight(element.dataset.descentLeftWeight)],
			[0, readWeight(element.dataset.descentStraightWeight)],
			[1, readWeight(element.dataset.descentRightWeight)],
		];

		function pickWeighted(options: WeightedGlyph[]): Glyph | undefined {
			const enabled = options.filter((option) => option.weight > 0);
			const pool = enabled.length > 0 ? enabled : options;
			const totalWeight = pool.reduce((total, option) => total + (enabled.length > 0 ? option.weight : 1), 0);
			let choice = Math.random() * totalWeight;
			for (const option of pool) {
				choice -= enabled.length > 0 ? option.weight : 1;
				if (choice <= 0) return option.glyph;
			}
			return pool.at(-1)?.glyph;
		}

		function glyphAt(x: number, y: number): Glyph | undefined {
			return glyphGrid.get(`${x},${y}`);
		}

		function moveTo(glyph: Glyph): void {
			position = { x: glyph.x, y: glyph.y };
		}

		function rememberHit(now: number): void {
			const key = `${position.x},${position.y}`;
			if (glyphGrid.has(key)) trail.set(key, now);
		}

		function beginLightning(x: number, now: number): void {
			phase = 'lightning';
			lightning = [];
			cycleStart = chooseCycleStart();
			lightningHead = { x, y: position.y };
			addLightningGlyph(now);
		}

		function addLightningGlyph(now: number): void {
			const character = LIGHTNING_GLYPHS[Math.floor(Math.random() * LIGHTNING_GLYPHS.length)];
			lightning.push({
				...lightningHead,
				code: character.codePointAt(0) ?? 42,
				createdAt: now,
				rotation: (Math.random() - 0.5) * Math.PI,
				scaleX: 0.6 + Math.random() * 1.15,
				scaleY: 0.7 + Math.random() * 0.9,
			});
		}

		function prepareSlashJump(now: number): void {
			if (glyphAt(position.x, position.y)?.character !== '/') return;

			let slashCount = 0;
			let landing: Glyph | undefined;
			for (let y = position.y; y <= maxY; y += 1) {
				const glyph = glyphAt(position.x, y);
				if (glyph?.character === '/') {
					slashCount += 1;
					continue;
				}
				if (glyph) {
					landing = glyph;
					break;
				}
			}

			if (!landing || slashCount === 0 || !downReachable.has(pointKey(landing))) return;
			slashLanding = { x: landing.x, y: landing.y };
			slashWaitUntil = now + slashCount * TICK_MS;
		}

		function advance(now: number): void {
			if (slashLanding !== null) {
				if (now < slashWaitUntil) return;
				position = slashLanding;
				slashLanding = null;
				if (position.y >= maxY) phase = 'bottom';
				rememberHit(now);
				return;
			}

			switch (phase) {
				case 'up': {
					const targetY = position.y - 1;
					const candidates: WeightedGlyph[] = [];
					for (const [offset, weight] of ascentMoveWeights) {
						const glyph = glyphAt(position.x + offset, targetY);
						if (glyph && upReachable.has(pointKey(glyph))) candidates.push({ glyph, weight });
					}
					const next = pickWeighted(candidates);
					if (next) moveTo(next);
					if (position.y <= topTransitionY) {
						phase = 'right';
					}
					break;
				}
				case 'right': {
					const targetX = position.x + 1;
					const candidates: WeightedGlyph[] = [];
					for (const [offset, weight] of topMoveWeights) {
						const glyph = glyphAt(targetX, position.y + offset);
						if (glyph && rightReachable.has(pointKey(glyph))) candidates.push({ glyph, weight });
					}
					const next = pickWeighted(candidates);
					if (next) moveTo(next);
					if (position.x >= topRightTransitionX) {
						phase = 'down';
					}
					break;
				}
				case 'down': {
					const targetY = position.y + 1;
					const candidates: WeightedGlyph[] = [];
					for (const [offset, weight] of descentMoveWeights) {
						const glyph = glyphAt(position.x + offset, targetY);
						if (glyph && downReachable.has(pointKey(glyph))) candidates.push({ glyph, weight });
					}
					const next = pickWeighted(candidates);
					if (next) moveTo(next);
					prepareSlashJump(now);
					if (position.y >= maxY) phase = 'bottom';
					break;
				}
				case 'bottom': {
					if (position.x <= cycleStart.x && position.x <= bottomLeftIslandMaxX) {
						phase = 'up';
						lightning = [];
						break;
					}
					const targetX = position.x - 1;
					if (targetX < artOffsetX) {
						position = { x: cycleStart.x, y: cycleStart.y };
						phase = 'up';
						lightning = [];
					} else {
						const next = glyphAt(targetX, position.y);
						if (next) moveTo(next);
						else beginLightning(targetX, now);
					}
					break;
				}
				case 'lightning': {
					const targetX = lightningHead.x - 1;
					const landing = glyphAt(targetX, lightningHead.y);
					if (landing) {
						moveTo(landing);
						phase = 'bottom';
					} else if (targetX >= artOffsetX) {
						lightningHead.x = targetX;
						addLightningGlyph(now);
					} else {
						position = { x: cycleStart.x, y: cycleStart.y };
						phase = 'up';
					}
					break;
				}
			}

			rememberHit(now);
		}

		function drawLightningGlyph(glyph: LightningGlyph, alpha: number): void {
			const sourceX = (glyph.code % atlasColumns) * cellSize;
			const sourceY = Math.floor(glyph.code / atlasColumns) * cellSize;
			context.save();
			context.globalAlpha = alpha;
			context.translate((glyph.x + 0.5) * cellSize, (glyph.y + 0.5) * cellSize);
			context.rotate(glyph.rotation);
			context.scale(glyph.scaleX, glyph.scaleY);
			context.drawImage(
				accentAtlas,
				sourceX,
				sourceY,
				cellSize,
				cellSize,
				-cellSize / 2,
				-cellSize / 2,
				cellSize,
				cellSize,
			);
			context.restore();
		}

		function renderFrame(now: number): void {
			context.clearRect(0, 0, canvas.width, canvas.height);
			renderStars(now);
			for (const glyph of glyphs) {
				drawGlyph(baseAtlas, glyph.code, glyph.x, glyph.y);
				const hitAt = trail.get(`${glyph.x},${glyph.y}`);
				if (hitAt === undefined) continue;
				const age = now - hitAt;
				if (age >= TRAIL_DURATION_MS) {
					trail.delete(`${glyph.x},${glyph.y}`);
					continue;
				}
				context.globalAlpha = Math.pow(1 - age / TRAIL_DURATION_MS, 1.65);
				drawGlyph(accentAtlas, glyph.code, glyph.x, glyph.y);
				context.globalAlpha = 1;
			}

			if (phase !== 'lightning') {
				drawGlyph(accentAtlas, 64, position.x, position.y);
			}

			for (const glyph of lightning) {
				const alpha = Math.max(0, 1 - (now - glyph.createdAt) / (TICK_MS * 4));
				if (alpha > 0) drawLightningGlyph(glyph, alpha);
			}
		}

		function animate(now: number): void {
			if (!element.isConnected) return;
			const stepDuration = phase === 'bottom' || phase === 'lightning' ? FAST_TICK_MS : TICK_MS;
			if (now - lastStepAt >= stepDuration) {
				advance(now);
				lastStepAt = now;
			}
			renderFrame(now);
			requestAnimationFrame(animate);
		}

		rememberHit(lastStepAt);
		requestAnimationFrame(animate);
	}

	function initializeAllAsciiCanvases(): void {
		document.querySelectorAll<HTMLElement>('[data-ascii-canvas]').forEach((element) => {
			void initializeAsciiCanvas(element);
		});
	}

	initializeAllAsciiCanvases();
	document.addEventListener('astro:page-load', initializeAllAsciiCanvases);
</script>

<style>
	.ascii-canvas {
		width: fit-content;
		max-width: 100%;
		margin: 0 auto;
		overflow: auto hidden;
	}

	.ascii-canvas--full-width {
		width: 100%;
		overflow: hidden;
	}

	.ascii-canvas--full-width canvas {
		width: 100%;
	}

	canvas {
		display: block;
		max-width: none;
		height: auto;
		image-rendering: pixelated;
	}

	.fallback {
		margin: 0;
		font: 16px/1 monospace;
		white-space: pre;
	}

	.source {
		display: none;
	}
</style>
