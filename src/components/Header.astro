---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

---

<header>
	<nav>
		<h2><a href="/" class="font-sixtyfour font-medium tracking-[-0.14em]" style="position: relative; z-index: 1;">
				k
				<span class="italic text-accent">u</span>
				ch
				<span class=" text-accent">e</span>
				n
		</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">home</HeaderLink>
			<HeaderLink href="/blog">blog</HeaderLink>
			<HeaderLink href="/about">about</HeaderLink>
		</div>
		<div class="social-links">
			<a
				class="github-button"
				href="https://github.com/kuucheen"
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
					<path d="M9 18c-4.51 2-5-2-7-2"></path>
				</svg>
				<span>GitHub</span>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}

	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}

	h2 {
		justify-self: start;
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}

	.internal-links {
		justify-self: center;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	nav a {
		padding: 0.5em 0 0.2em 0;
		margin-right: 1rem;
		color: var(--text-white);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}

	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
		border-bottom-width: 0.2rem;
	}

	.social-links {
		justify-self: end;
		display: flex;
	}

	.social-links .github-button {
		display: inline-flex;
		height: 2rem;
		box-sizing: border-box;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		margin: 0;
		padding: 0 0.625rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 0.625rem;
		background: rgba(255, 255, 255, 0.04);
		color: var(--text-white);
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1;
		white-space: nowrap;
		transition: border-color 150ms ease, background-color 150ms ease;
	}

	.social-links .github-button:hover {
		border-color: rgba(255, 255, 255, 0.16);
		background: rgba(255, 255, 255, 0.08);
		color: var(--text-white);
	}

	.social-links .github-button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.github-button svg {
		width: 1rem;
		height: 1rem;
		flex: none;
	}

	@media (max-width: 720px) {
		.social-links {
			display: none;
		}

		nav {
			grid-template-columns: 1fr auto 1fr;
		}
	}
</style>
