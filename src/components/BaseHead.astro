<rect class="white" x=".0075" y="13.9316" width="11.7786" height="1.1528" rx=".5764" ry=".5764"/>
<rect class="accent" x="13.7539" y="13.9316" width="14.1786" height="1.1528" rx=".5764" ry=".5764"/>
