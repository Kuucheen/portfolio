---
import { SITE_TITLE } from '../consts';
import { createBrandMarkSvg, getPageAccent } from '../brand';

interface Props {
	accent?: string;
}

const { accent: accentOverride } = Astro.props;
const today = new Date();
const logoSvg = createBrandMarkSvg(accentOverride ?? getPageAccent(Astro.url.pathname), {
	className: 'logo-mark',
	width: 84,
	height: 45,
});
const socialLinkClasses =
	'group grid size-9 place-items-center rounded-[0.625rem] border border-white/10 bg-white/[0.04] text-[var(--text-white)] transition-colors duration-150 hover:border-accent hover:bg-white/[0.08] focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-accent';
---

<footer class="w-full border-t border-white/10 bg-(--gray-primary) text-(--text-white)">
	<div
		class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-10 px-6 py-10 sm:grid-cols-[1fr_auto_1fr] sm:items-start sm:gap-4 sm:px-8"
	>
		<a
			class="inline-flex justify-self-center rounded-[0.625rem] p-2 transition-colors duration-150 hover:bg-white/6 focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-accent sm:col-start-2 sm:row-start-1"
			href="/"
			aria-label={`${SITE_TITLE} home`}
		>
			<span
				class="block h-11.25 w-21 [&_.logo-mark]:block [&_.logo-mark]:size-full [&_.logo-mark]:shrink-0"
				set:html={logoSvg}
			></span>
		</a>

		<aside class="grid place-items-start gap-2 sm:col-start-1 sm:row-start-1">
		<p class="m-0 text-[0.9rem] leading-[1.6] text-(--text-white-secondary)">
			<strong class="font-aldrich text-base text-(--text-white)">{SITE_TITLE}</strong>
			<!--<br />-->
			<!--Projects, writing, and ways to get in touch.-->
			<br />
			<span class="text-[0.8rem]">&copy; {today.getFullYear()} Kuchen. All rights reserved.</span>
		</p>
	</aside>

		<nav
			class="grid justify-self-start place-items-start gap-2 sm:col-start-3 sm:row-start-1 sm:justify-self-end"
			aria-label="Social links"
		>
		<h2
			class="footer-title m-0! font-aldrich text-[0.75rem]! tracking-[0.08em] text-(--text-white-secondary)"
		>
			Social
		</h2>
		<div class="grid grid-flow-col gap-3">
			<a
				class={socialLinkClasses}
				href="https://github.com/kuucheen"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Kuucheen on GitHub"
			>
				<svg
					class="size-5 text-(--text-white) transition-colors duration-150 group-hover:text-accent"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						fill="currentColor"
						d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.75 0c2.19-1.49 3.15-1.18 3.15-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z"
					></path>
				</svg>
			</a>

			<a
				class={socialLinkClasses}
				href="https://discord.com/users/1124269498631983114"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Kuucheen on Discord"
			>
				<svg
					class="size-5 text-(--text-white) transition-colors duration-150 group-hover:text-accent"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						fill="currentColor"
						d="M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52.08.08 0 0 0-.08.04c-.21.38-.46.88-.61 1.25a18.3 18.3 0 0 0-5.48 0 12.6 12.6 0 0 0-.62-1.25.08.08 0 0 0-.08-.04 19.7 19.7 0 0 0-4.88 1.52.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06c0 .02.01.04.03.05a19.9 19.9 0 0 0 5.99 3.03.08.08 0 0 0 .09-.03c.46-.63.87-1.3 1.22-1.99a.08.08 0 0 0-.04-.1c-.65-.25-1.27-.55-1.87-.9a.08.08 0 0 1-.01-.12l.37-.3a.07.07 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.06 0a.07.07 0 0 1 .08.01l.37.3a.08.08 0 0 1-.01.12c-.59.35-1.21.65-1.87.9a.08.08 0 0 0-.04.1c.36.7.77 1.37 1.23 2a.08.08 0 0 0 .08.02 19.8 19.8 0 0 0 6-3.03.08.08 0 0 0 .03-.05c.5-5.18-.84-9.68-3.55-13.66a.06.06 0 0 0-.03-.03ZM8.02 15.33c-1.18 0-2.16-1.09-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.33-.96 2.42-2.16 2.42Zm7.98 0c-1.18 0-2.16-1.09-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.17 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42Z"
					></path>
				</svg>
			</a>

			<a class={socialLinkClasses} href="mailto:xkuchen@proton.me" aria-label="Email Kuchen">
				<svg
					class="size-5 text-(--text-white) transition-colors duration-150 group-hover:text-accent"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						fill="currentColor"
						d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
	</div>
</footer>
