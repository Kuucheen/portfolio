---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AsciiArtCanvas from '../components/AsciiArtCanvas.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DiscordStatus from '../components/DiscordStatus.astro';
import CopyButton from '../components/CopyButton.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import artwork from '../assets/ascii/ear.txt?raw';

const projects = [
	{
		title: 'KC-Checker',
		description: 'Advanced open-source proxy checker written in Go',
		imageSrc:
			'https://repository-images.githubusercontent.com/719058370/b008aa88-4d44-44b8-ac09-2cd884413f26',
		imageAlt: 'KC-Checker project preview',
		href: 'https://github.com/kuucheen/KC-Checker',
		tags: [
			{ label: 'Proxies', color: 'primary' },
		],
	},
	{
		title: 'KC-Scraper',
		description: 'A powerful open-source proxy scraper ',
		imageSrc:
			'https://repository-images.githubusercontent.com/519901963/08c37937-1ba2-45b4-822c-56ddf59d7b96',
		imageAlt: 'KC-Scraper project preview',
		href: 'https://github.com/kuucheen/KC-Scraper',
		tags: [{ label: 'Proxies', color: 'primary' }],
	},
	{
		title: 'Magpie',
		description: 'Magpie is a multi-user AIO Proxy Manager ',
		imageSrc:
			'https://repository-images.githubusercontent.com/889902532/0c845a2c-2659-4ba5-80ba-87a5adb086c6',
		imageAlt: 'Magpie project preview',
		href: 'https://github.com/Kuucheen/magpie',
		tags: [
			{ label: 'Proxies', color: 'primary' },
		],
	},
	// {
	// 	title: 'gif-to-plymouth',
	// 	description: 'Turn any animated GIF into a Linux Plymouth boot splash theme.  ',
	// 	imageSrc:
	// 		'plymouth',
	// 	imageAlt: 'gif-to-plymouth project preview',
	// 	href: 'https://github.com/Kuucheen/gif-to-plymouth',
	// 	tags: [
	// 		{ label: 'Tool', color: 'success' },
	// 	],
	// },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.home {
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 0;
			}

			.hero {
				min-height: 100svh;
				display: grid;
				place-items: center;
				text-align: center;
			}

			.hero h1 {
				margin: 0;
			}

			.hero-art :global(.ascii-canvas) {
				margin: 0;
				overflow: hidden;
			}

			.content {
				width: min(720px, calc(100% - 2rem));
				margin-inline: auto;
				padding-block: 5rem;
			}

			.projects {
				width: min(760px, calc(100vw - 2rem));
				margin-inline: 50%;
				transform: translateX(-50%);
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
			}

			.profile-section {
				width: min(760px, calc(100vw - 2rem));
				margin: 3rem 50% 0;
				transform: translateX(-50%);
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(17rem, 22rem);
				gap: 1.5rem;
			}

			@media (max-width: 820px) {
				.projects {
					grid-template-columns: 1fr;
				}

				.profile-section {
					grid-template-columns: 1fr;
				}
			}

			:global(body.home-page > header) {
				position: absolute;
				inset: 0 0 auto;
				z-index: 10;
				width: 100%;
				box-sizing: border-box;
			}

		</style>
		<title>kuchen</title>
	</head>
	<body class="home-page">
		<Header />
		<main class="home">
			<section
				class="hero text-3xl"
				style="position: relative; isolation: isolate; overflow: hidden;"
			>
				<div
					class="hero-art"
					aria-hidden="true"
					style="position: absolute; inset: 0; z-index: 0; display: grid; place-items: center; overflow: hidden; opacity: 0.28; pointer-events: none;"
				>
					<AsciiArtCanvas
						id="ascii-art"
						art={artwork}
						atlasSrc="/fonts/cp437_16x16.png"
						label="ASCII artwork of an ear"
						animated
						fullWidth
						ascentWeights={{ left: 1, straight: 1, right: 3 }}
						topWeights={{ up: 1, straight: 1, down: 1 }}
						descentWeights={{ left: 1, straight: 1, right: 1.5 }}
					/>
				</div>
				<h1 class="font-sixtyfour font-medium tracking-[-0.14em]" style="position: relative; z-index: 1;">
					k
					<span class="italic text-accent">u</span>
					ch
					<span class=" text-accent">e</span>
					n
				</h1>
			</section>
			<div class="content">

				<h2 class="text-center pb-10">my projects</h2>

				<div class="projects pb-10">
					{
						projects.map((project) => (
							<ProjectCard
								title={project.title}
								description={project.description}
								imageSrc={project.imageSrc}
								imageAlt={project.imageAlt}
								href={project.href}
								tags={project.tags}
							/>
						))
					}
				</div>

				<h2 class="text-center pb-2 pt-10">contact me</h2>

				<section class="profile-section items-center" aria-label="Profile">
					<div class="profile-copy min-h-px self-center leading-1">
						<p class="mb-2 flex items-center gap-2">
							<span>email:</span>
							<a href="mailto:xkuchen@proton.me">xkuchen@proton.me</a>
							<CopyButton value="xkuchen@proton.me" label="Copy email address" />
						</p>
						<p class="mb-0 flex items-center gap-2">
							<span>discord:</span>
							<a href="https://discord.com/users/1124269498631983114" target="_blank" rel="noopener noreferrer">@kuucheen</a>
							<CopyButton value="https://discord.com/users/1124269498631983114" label="Copy Discord username" />
						</p>
						<p class="mb-0 flex items-center gap-2">
							<span>github:</span>
							<a href="https://github.com/kuucheen" target="_blank" rel="noopener noreferrer">kuucheen</a>
							<CopyButton value="https://github.com/kuucheen" label="Copy GitHub username" />
						</p>
					</div>
					<DiscordStatus userId="1124269498631983114" />
				</section>

			</div>
		</main>
		<Footer />
	</body>
</html>
