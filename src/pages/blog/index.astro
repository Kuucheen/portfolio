---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import AsciiHoverBurst from '../../components/AsciiHoverBurst.astro';
import AsciiNoiseCanvas from '../../components/AsciiNoiseCanvas.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import goAlgorithmsImage from '../../assets/blog-images/algorithms.png';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.filter((post) => !post.id.startsWith('algorithms/'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				max-width: 640px;
				margin-inline: auto;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			.algorithm-preview {
				position: relative;
				isolation: isolate;
				display: grid;
				place-items: center;
				aspect-ratio: 2 / 1;
				overflow: hidden;
				margin-bottom: 0.5rem;
				border-radius: 12px;
				background: color-mix(in srgb, var(--text-white) 2%, var(--gray-primary));
			}
			.algorithm-art {
				position: absolute;
				inset: 0;
				z-index: 0;
				overflow: hidden;
				opacity: 0.42;
				pointer-events: none;
			}
			.algorithm-art :global(.ascii-noise-canvas) {
				width: 100%;
				height: 100%;
			}
			.algorithm-preview img {
				position: absolute;
				inset: 0;
				z-index: 1;
				height: 100%;
				margin: 0;
				border-radius: 0;
				object-fit: contain;
				filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.5));
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: var(--text-white);
				line-height: 1;
			}
			.date {
				margin: 0;
				color: var(--text-white-secondary);
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--accent);
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			ul a:hover .algorithm-preview {
				box-shadow: var(--box-shadow);
			}
			ul a:hover .algorithm-preview img {
				box-shadow: none;
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					<li class="relative">
						<a href="/blog/algorithms/">
							<div class="algorithm-preview">
								<div class="algorithm-art" aria-hidden="true">
									<AsciiNoiseCanvas />
								</div>
								<Image
									width={720}
									height={360}
									src={goAlgorithmsImage}
									alt="Go algorithms"
								/>
							</div>
						</a>
						<AsciiHoverBurst />
					</li>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
